<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rak_wbc_perception</name>
  <version>0.1.0</version>
  <description>Camera/LiDAR perception: detection, segmentation, markers and visual servoing.</description>
  <maintainer email="team@example.com">rak-wbc team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rak_wbc_msgs</exec_depend>
  <!-- TODO: add heavy dependencies only after they are installed:
       cv_bridge, vision_msgs, moveit_py, py_trees, ... -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
